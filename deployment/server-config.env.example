# Server Configuration Template for Alkana Dashboard
# Copy this file to server-config.env and fill in your actual values
# WARNING: server-config.env is gitignored - never commit it to version control!

# ==============================================
# SERVER CONNECTION
# ==============================================
SERVER_HOST=your-server-ip-or-domain    # e.g., 192.168.1.100 or dashboard.example.com
SERVER_USER=your-ssh-username           # SSH username (e.g., ubuntu, admin, etc.)
SERVER_PASSWORD=your-ssh-password       # SSH password (or use SSH keys instead)
SERVER_PORT=22

# ==============================================
# APPLICATION SETTINGS
# ==============================================
APP_DOMAIN=your-server-ip-or-domain     # Use IP if no domain (same as SERVER_HOST usually)
USE_SSL=false                           # Set to true if you have a domain and SSL certificate
ADMIN_EMAIL=admin@example.com

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
PROD_DB_NAME=alkana_dashboard
PROD_DB_USER=alkana_user
PROD_DB_PASSWORD=your-secure-db-password    # IMPORTANT: Use a strong password!
DB_PASSWORD=${PROD_DB_PASSWORD}             # Alias for compatibility

# ==============================================
# GITHUB REPOSITORY (Optional)
# ==============================================
GITHUB_REPO=your-org/alkana-dashboard   # Your GitHub repository
GITHUB_BRANCH=main

# ==============================================
# DEPLOYMENT SETTINGS
# ==============================================
AUTO_BACKUP=true
AUTO_MIGRATE_DB=true
HEALTH_CHECK_ENABLED=true
MONITORING_ENABLED=true

# ==============================================
# BACKUP SETTINGS
# ==============================================
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"             # Daily at 2 AM (cron format)

# ==============================================
# HEALTH CHECK SETTINGS
# ==============================================
HEALTH_CHECK_INTERVAL=300               # 5 minutes (in seconds)
ALERT_ON_FAILURE=true

# ==============================================
# NOTES
# ==============================================
# 1. Copy this file: cp server-config.env.example server-config.env
# 2. Edit server-config.env with your actual credentials
# 3. Never commit server-config.env to Git (it's already in .gitignore)
# 4. Keep your credentials secure and use strong passwords
# 5. For production, consider using SSH keys instead of passwords
