# Server Configuration for Alkana Dashboard
# This file contains server-specific settings

# Server Connection
SERVER_IP=192.168.68.166
SERVER_USER=alkana
SERVER_PASSWORD=alkana123
SERVER_PORT=22

# Application Settings
APP_DOMAIN=192.168.68.166  # Use IP if no domain
USE_SSL=false  # Set to true if you have a domain and want SSL
ADMIN_EMAIL=admin@alkana.local

# Database Configuration
PROD_DB_NAME=alkana_dashboard
PROD_DB_USER=alkana_user
PROD_DB_PASSWORD=alkana_secure_pass_2026

# GitHub Repository (update with your repo)
GITHUB_REPO=your-org/alkana-dashboard
GITHUB_BRANCH=main

# Deployment Settings
AUTO_BACKUP=true
AUTO_MIGRATE_DB=true
HEALTH_CHECK_ENABLED=true
MONITORING_ENABLED=true

# Backup Settings
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# Health Check Settings
HEALTH_CHECK_INTERVAL=300  # 5 minutes
ALERT_ON_FAILURE=true
